# Copy to .env (never commit). Prefer a real secret manager in production.
# Ledger + artifacts live under DATA_DIR.
DATA_DIR=.data
LOG_LEVEL=info

# Salt for card fingerprinting. Generated once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CARD_FP_SALT=change-me

# Demo biller base URL
DEMO_BILL_URL=http://127.0.0.1:4600

# Card material is read from the environment by card reference, e.g. --card demo
# reads BILLING_CARD_DEMO_*. Never write real PANs into this file.
BILLING_CARD_DEMO_NUMBER=4111111111111111
BILLING_CARD_DEMO_EXPIRY=12/30
BILLING_CARD_DEMO_CVV=123
BILLING_CARD_DEMO_NAME=Ada Lovelace
BILLING_CARD_DEMO_KIND=debit
